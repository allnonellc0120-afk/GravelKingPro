# Credentials and service-account JSON
*.json
attached_assets/*.json

# Source configuration is required for a reproducible off-platform checkout.
!package.json
!tsconfig*.json
!components.json
!/app.json
!/gka_spec.json
!artifacts/**/seo.config.json
!artifacts/**/slides-manifest.json
!artifacts/**/sdm.schema.json
!artifacts/**/public/.well-known/assetlinks.json

