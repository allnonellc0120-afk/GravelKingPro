run = "python main.py"
entrypoint = "main.py"
modules = ["python-3.11", "nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"
run = ["python3", "main.py"]

[nix]
channel = "stable-23_11"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Morris Law Kernel: Python"

[[workflows.workflow]]
name = "Morris Law Kernel: Python"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
REPLICATE_RVC_MODEL = "zsxkib/realistic-voice-cloning"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
