run = "python main.py"
entrypoint = "main.py"
modules = ["python-3.11", "nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"
run = ["python3", "main.py"]

[nix]
channel = "stable-23_11"
packages = ["ffmpeg-headless", "poetry"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Morris Law Kernel: Python"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GK Pro Vertex Allowlist Proxy"

[[workflows.workflow]]
name = "Morris Law Kernel: Python"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GK Pro Vertex Allowlist Proxy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run proxy:vertex"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
REPLICATE_RVC_MODEL = "zsxkib/realistic-voice-cloning"
SENDGRID_FROM_EMAIL = "kevm@gravelkingpro.it.com"
SENDGRID_MODE = "mock"

[userenv.development]
GRAVELKING_ARTIST_ID = "customer-zero"
VITE_API_BASE_URL = "/api"
VITE_PROXY_GATEWAY = "http://127.0.0.1:8080"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[deployment.responseHeaders]]
path = "/"
name = "Cache-Control"
value = "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

[[deployment.responseHeaders]]
path = "/*.html"
name = "Cache-Control"
value = "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

[[deployment.responseHeaders]]
path = "/sw.js"
name = "Cache-Control"
value = "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

[[deployment.responseHeaders]]
path = "/manifest.json"
name = "Cache-Control"
value = "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"

[[deployment.responseHeaders]]
path = "/manifest.webmanifest"
name = "Cache-Control"
value = "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
