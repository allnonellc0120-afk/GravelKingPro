# GravelKing Pro — Environment Template
# Copy to .env and fill in real values. Never commit secrets.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gravelking:gravelking@postgres:5432/gravelking
DB_USER=gravelking
DB_PASSWORD=gravelking
DB_NAME=gravelking

# ── Session / HMAC ───────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-256-bit-random-secret

# ── Stripe (direct secret-key path) ──────────────────────────────────────────
# Optional if you use the Replit Stripe integration; required as fallback.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Replit Connectors (auto-injected by Replit when integration is bound) ──────
REPLIT_CONNECTORS_HOSTNAME=connectors.replit.com
REPL_IDENTITY=

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
GCP_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Object Storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=private

# ── Optional admin/debug ───────────────────────────────────────────────────────
ADMIN_KEY=change-me
