# GravelKing Pro sanitized recovery template.
# Copy to .env and replace every REQUIRED placeholder. Never commit .env.

# Required: database and runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NODE_ENV=production
PORT=8080
BASE_PATH=/
LOG_LEVEL=info
SESSION_SECRET=replace-with-a-long-random-secret

# Required when using Replit-managed Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Required for Vertex/Gemini-backed generation or transcription
GCP_SERVICE_ACCOUNT=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Required for object storage-backed audio/jobs
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=private

# Required only when the deployment uses the remote kernel service
REMOTE_KERNEL_API_KEY=
MLK_KERNEL_URL=

# Required for admin-only operations
ADMIN_KEY=
ADMIN_SECRET=

# Payment and mail integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Optional service configuration
FINGERPRINT_SERVICE_API_KEY=
FINGERPRINT_SERVICE_URL=
DEMUCS_URL=
REPLICATE_RVC_MODEL="zsxkib/realistic-voice-cloning"
BING_API_KEY=
JAX_VOICE_ID=
WEEKEND_NOTIFY_EMAIL=
CREDIT_WALLET_TEST_PORT=
MASTERING_EQ_TEST_PORT=
PLAYWRIGHT_EXECUTABLE_PATH=

# Replit-only connector/runtime values; normally injected by the platform
REPL_ID=
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
REPLIT_EXPO_DEV_DOMAIN=
