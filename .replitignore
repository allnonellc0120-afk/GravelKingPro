# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.
# NOTE: excluded paths are absent in the deploy builder too — never exclude
# anything imported at build time (e.g. attached_assets/IMG_1956/IMG_1957 pngs
# used by gravelkingpro-promo scenes) or needed at runtime (.pythonlibs).

# No need to store the pnpm store twice.
.local
.cache
.config/npm
.git

# Production static directories and API bundles are required by the publish
# router after artifact builds complete; do not exclude their dist outputs.
artifacts/api-server/dist-test

# The promotional video artifact is a standalone deliverable and has no
# production service in this autoscale deployment.
artifacts/gravelking-promo

# Local/test audio and generated export bundles are not runtime dependencies.
artifacts/api-server/local_masters
*.zip
*.mp4
zi*

# Heavy media never referenced by any build or runtime code
attached_assets/final_promos
attached_assets/generated_videos
attached_assets/generated
attached_assets/*.aab
attached_assets/*.mp4
attached_assets/*.mov
attached_assets/*.webm
attached_assets/*.wav
attached_assets/*.zip

# Dev-only project folders
android-twa
screenshots
MorrisLawKernel
deliverables
business-package
exports
seeds
vendor/tmp
